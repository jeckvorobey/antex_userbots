# Секреты и bootstrap-настройки swarm userbot.
# Скопируй в .env и подставь реальные значения.

# OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Строковые Telethon-сессии для каждого бота из settings.toml
# Названия должны совпадать с session_env в [[swarm.bots]]
SESSION_STRING_DMITRY=your_telethon_session_string_for_dmitry
SESSION_STRING_VITALY=your_telethon_session_string_for_vitaly

# Общий proxy URL для Telegram и OpenRouter (необязательно)
# Пример: http://user:pass@127.0.0.1:8080
PROXY=
